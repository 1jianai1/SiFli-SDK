+/* ==========================================================================
+ * 故障现场导出 (driver-side, 不依赖 ulog)
+ *
+ * 背景: SDIO 初始化打通之后, aicwf_wifi_init_task 线程会在 fhost 平台初始化
+ *   收尾处 (建完 fhost_rx / rwnx_timer 等任务、固件下载之前) 触发 HardFault。
+ *   核心的故障处理函数随后要打印现场, 但它的打印会走 ulog, 而此刻该线程正持有
+ *   ulog 输出锁 (hold==1), 故障处理函数又把它递归拿到 hold==2, 于是被
+ *   RT_ASSERT(ulog.output_locker.hold == 1) (ulog.c:297) 打断 ——
+ *   日志里只剩 [ULOG-REENT] + 断言, 真正的第一次故障现场被第二次死机吃掉。
+ *
+ * 本钩子绕开这条死路:
+ *   - rt_hw_exception_install() 注册的钩子在核心故障打印【之前】被调用
+ *     (rtos/rtthread/libcpu/arm/cortex-m33/cpuport.c:475-481), 参数就是硬件
+ *     压栈的异常帧 {r0,r1,r2,r3,r12,lr,pc,psr};
+ *   - 钩子里用 rt_device_write() 直写控制台设备 (同 ulog_forensic_dump 的做法),
+ *     不经过 ulog, 因此不会再触发上面的断言;
+ *   - 返回非 RT_EOK, 核心原有行为不变 (现场已先落盘)。
+ *
+ * 只改 WiFi 驱动, 不触碰 ulog / cpuport。
+ * ========================================================================== */
+
+/* 与 cortex-m33/cpuport.c:47-57 的 struct exception_stack_frame 布局一致
+ * (该结构定义在 .c 内部, 公开头文件没有, 故按 ABI 镜像一份) */
+struct aicwf_exception_frame
+{
+    rt_uint32_t r0;
+    rt_uint32_t r1;
+    rt_uint32_t r2;
+    rt_uint32_t r3;
+    rt_uint32_t r12;
+    rt_uint32_t lr;
+    rt_uint32_t pc;
+    rt_uint32_t psr;
+};
+
+/* SCB 寄存器: 用裸地址, 避免为几个读数引入额外头依赖 */
+#define AICWF_SCB_ICSR   (*(volatile rt_uint32_t *)0xE000ED04UL)
+#define AICWF_SCB_CFSR   (*(volatile rt_uint32_t *)0xE000ED28UL)
+#define AICWF_SCB_HFSR   (*(volatile rt_uint32_t *)0xE000ED2CUL)
+#define AICWF_SCB_MMFAR  (*(volatile rt_uint32_t *)0xE000ED34UL)
+#define AICWF_SCB_BFAR   (*(volatile rt_uint32_t *)0xE000ED38UL)
+
+static rt_err_t aicwf_fault_hook(void *context)
+{
+    struct aicwf_exception_frame *f = (struct aicwf_exception_frame *)context;
+    char buf[400];
+    int len = 0;
+    rt_uint32_t psp, msp;
+    rt_thread_t self = rt_thread_self();
+    rt_device_t dev;
+
+    if (f == RT_NULL)
+        return -RT_ERROR;
+
+    __asm volatile ("mrs %0, psp" : "=r"(psp));
+    __asm volatile ("mrs %0, msp" : "=r"(msp));
+
+    len = rt_snprintf(buf, sizeof(buf),
+                      "\r\n[AIC-FAULT] first-fault: pc=%08x lr=%08x psr=%08x\r\n"
+                      "[AIC-FAULT] r0=%08x r1=%08x r2=%08x r3=%08x r12=%08x\r\n"
+                      "[AIC-FAULT] cfsr=%08x hfsr=%08x mmfar=%08x bfar=%08x icsr=%08x\r\n"
+                      "[AIC-FAULT] psp=%08x msp=%08x thread=%s\r\n",
+                      (unsigned)f->pc, (unsigned)f->lr, (unsigned)f->psr,
+                      (unsigned)f->r0, (unsigned)f->r1, (unsigned)f->r2,
+                      (unsigned)f->r3, (unsigned)f->r12,
+                      (unsigned)AICWF_SCB_CFSR, (unsigned)AICWF_SCB_HFSR,
+                      (unsigned)AICWF_SCB_MMFAR, (unsigned)AICWF_SCB_BFAR,
+                      (unsigned)(AICWF_SCB_ICSR & 0x1FFUL),
+                      (unsigned)psp, (unsigned)msp,
+                      (self != RT_NULL && self->name != RT_NULL) ? self->name : "?");
+
+    /* 直写控制台设备, 绕开 ulog 的输出锁 (ulog_forensic_dump 同款做法) */
+    dev = rt_console_get_device();
+    if ((dev != RT_NULL) && (len > 0))
+    {
+        rt_uint16_t old_flag = dev->open_flag;
+
+        if (len > (int)sizeof(buf) - 1)
+            len = (int)sizeof(buf) - 1;
+        dev->open_flag |= RT_DEVICE_FLAG_STREAM;
+        rt_device_write(dev, 0, buf, len);
+        dev->open_flag = old_flag;
+    }
+
+    return -RT_ERROR;   /* 保持核心原有处理(继续打印/停机); 我们的现场已先落盘 */
+}
